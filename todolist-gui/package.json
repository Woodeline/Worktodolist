{
  "name": "todolist-gui",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:app": "tauri build --no-bundle",
    "test:guard": "node scripts/assert-tests.mjs",
    "test:ui": "node scripts/qa-css-check.mjs && node scripts/qa-contrast.mjs && node scripts/qa-typography.mjs && node scripts/qa-hooks.mjs",
    "test:typography": "node scripts/qa-typography.mjs",
    "test:hooks": "node scripts/qa-hooks.mjs",
    "test:settings": "node scripts/qa-settings.mjs",
    "test:settings:shots": "node scripts/qa-settings.mjs --shots",
    "test:tools": "node scripts/qa-tools.mjs",
    "test:tools:shots": "node scripts/qa-tools.mjs --shots",
    "test:responsive": "node scripts/qa-responsive.mjs",
    "test:responsive:shots": "node scripts/qa-responsive.mjs --shots",
    "test:responsive:report": "node scripts/qa-responsive.mjs --report=qa-artifacts/responsive.json",
    "test:attack": "node --import ./scripts/register-qa-loader.mjs scripts/qa-independent.mjs"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.2",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "0.21.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
